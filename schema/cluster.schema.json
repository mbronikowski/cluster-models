{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbronikowski.github.io/cluster-models/schema/cluster.schema.json",
  "title": "Galaxy cluster entry (data/clusters/<slug>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "ra", "dec", "z"],
  "properties": {
    "name": {"type": "string", "minLength": 2, "description": "Primary designation; also the page title."},
    "common_names": {"$ref": "#/$defs/strings", "description": "Nicknames, e.g. Bullet Cluster."},
    "aka": {"$ref": "#/$defs/strings", "description": "Designations commonly used in the literature, shown under the title."},
    "designations": {"$ref": "#/$defs/strings", "description": "Further catalogue designations."},
    "ra": {"type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?$", "description": "J2000 right ascension, \"hh:mm:ss.s\" (quoted)."},
    "dec": {"type": "string", "pattern": "^[+-]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?$", "description": "J2000 declination, \"+dd:mm:ss.s\" (quoted, explicit sign)."},
    "z": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
    "programs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "image": {
      "type": "object", "additionalProperties": false, "required": ["url", "credit"],
      "properties": {"url": {"$ref": "#/$defs/url"}, "credit": {"type": "string", "minLength": 3}}
    },
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "notes": {"type": "string"},
    "ignore_position_check": {"$ref": "#/$defs/strings", "description": "Designations exempt from the position check (explain why in notes)."}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "url": {"type": "string", "pattern": "^(https?|ftp)://[^\\s]+$"},
    "ref": {
      "type": "string",
      "pattern": "^(\\d{4}[A-Za-z0-9&.]{14}[A-Za-z.]|arXiv:\\d{4}\\.\\d{4,5}|doi:10\\.\\d{4,9}/\\S+)$",
      "description": "ADS bibcode, arXiv:NNNN.NNNNN or doi:10.xxxx/..."
    },
    "link": {
      "type": "object", "additionalProperties": false, "required": ["label", "url"],
      "properties": {"label": {"type": "string", "minLength": 1}, "url": {"$ref": "#/$defs/url"}}
    },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 2},
        "program": {"$ref": "#/$defs/id"},
        "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "data": {"$ref": "#/$defs/strings"},
        "software": {"type": "string"},
        "availability": {"type": "string"},
        "status": {"type": "string"},
        "superseded_by": {"type": "string"},
        "tags": {"$ref": "#/$defs/strings"},
        "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "note": {"type": "string"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["facility"],
      "properties": {
        "facility": {"type": "string"},
        "instrument": {"type": "string"},
        "mode": {"type": "string", "description": "e.g. imaging, MOS, IFU, slitless, grism"},
        "filters": {"$ref": "#/$defs/strings"},
        "program": {"$ref": "#/$defs/id"},
        "proposal": {"type": "string", "description": "e.g. 'JWST GO 6882'"},
        "note": {"type": "string"}
      }
    }
  }
}
