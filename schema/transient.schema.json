{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbronikowski.github.io/cluster-models/schema/transient.schema.json",
  "title": "Lensed transient or variable source (data/transients/<slug>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "class",
    "status",
    "cluster"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "class": {
      "type": "string"
    },
    "subclass": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "images": {
      "type": "string",
      "description": "multiple (default) or single: whether the lens produces several images or only magnifies one."
    },
    "cluster": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "description": "Slug (file name) of the lensing cluster."
    },
    "ra": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?$"
    },
    "dec": {
      "type": "string",
      "pattern": "^[+-]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?$"
    },
    "z": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 20
    },
    "discovered": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(\\d{4}[A-Za-z0-9&.]{14}[A-Za-z.]|arXiv:\\d{4}\\.\\d{4,5}|doi:10\\.\\d{4,9}/\\S+)$"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^(https?|ftp)://[^\\s]+$"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
